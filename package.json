{
  "name": "kraai",
  "version": "0.4.3",
  "description": "Ephemeral full-stack preview environments on Cloudflare Workers, D1 by default, Neon via a pluggable database provider. Spin up a named, disposable environment and tear it down on command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kraai": "./bin/kraai.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cloudflare-workers",
    "d1",
    "neon",
    "preview-environments",
    "ephemeral",
    "ci",
    "hyperdrive",
    "github-action"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evatt-labs/kraai.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
